# Copy this file to .env and fill in real values. NEVER commit the real .env.

# Supabase Postgres connection string.
# Supabase Dashboard -> Connect (or Project Settings -> Database) -> "Transaction pooler".
# Use the TRANSACTION POOLER (port 6543), not the direct connection — serverless
# functions on Vercel open many short-lived connections and would exhaust a direct
# connection limit. Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres"

# Secret used to encrypt login session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
# Use a DIFFERENT value in production than in local development.
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-characters"
